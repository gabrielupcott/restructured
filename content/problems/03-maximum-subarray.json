{
  "id": "03-maximum-subarray",
  "title": "Maximum Subarray",
  "track": "Dynamic Programming",
  "difficulty": "medium",
  "topics": [
    "dynamic-programming",
    "arrays"
  ],
  "source": "canonical Maximum Subarray concept; description, examples, and tests re-authored",
  "description": "The input is an array of integers, possibly containing negatives. Return the largest sum achieved by any non-empty run of consecutive elements.",
  "constraints": [
    "1 <= len(nums) <= 10000",
    "-10000 <= nums[i] <= 10000"
  ],
  "parameters": [
    "nums"
  ],
  "functionName": "max_subarray",
  "starterCode": "def max_subarray(nums):\n    # Return the largest sum of any non-empty consecutive run.\n    ...\n",
  "examples": [
    {
      "input": {
        "nums": [
          5,
          -2,
          7,
          -8,
          3,
          6
        ]
      },
      "output": 11,
      "explanation": "The whole array sums to 11, beating the tail run 3 + 6."
    },
    {
      "input": {
        "nums": [
          -4,
          -1,
          -6
        ]
      },
      "output": -1,
      "explanation": "Every run is negative, so the single least-negative value wins."
    }
  ],
  "hints": [
    "A best run ending at each position either extends the best run ending at the position before it, or starts fresh here.",
    "A running total that has gone negative can never help the next position: drop it.",
    "Carry the running total and the best seen; each step takes value or running + value, whichever is larger."
  ],
  "solution": "Kadane sweep: keep the best sum of a run ending at the current position (restart when the carried sum is negative) and the global best. O(n) time, O(1) space.",
  "solutionCode": "def max_subarray(nums):\n    best = current = nums[0]\n    for value in nums[1:]:\n        current = value if current < 0 else current + value\n        if current > best:\n            best = current\n    return best\n",
  "bruteForceCode": "def max_subarray(nums):\n    n = len(nums)\n    best = nums[0]\n    for i in range(n):\n        running = 0\n        for j in range(i, n):\n            running += nums[j]\n            if running > best:\n                best = running\n    return best\n",
  "failureHint": "hidden tests include all-negative arrays, a single value, and runs crossing the midpoint",
  "expectedComplexity": {
    "time": "O(n)",
    "space": "O(1)"
  },
