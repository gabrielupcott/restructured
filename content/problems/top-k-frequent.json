{
  "id": "top-k-frequent",
  "title": "Top K Frequent Elements",
  "track": "Hash Maps",
  "difficulty": "medium",
  "topics": ["hash-maps"],
  "source": "canonical Top K Frequent Elements concept; description, examples, and tests re-authored",
  "description": "The input is an array of integers nums and an integer k. Return the k values that appear most often in nums, ordered from most frequent to least frequent. When two values appear equally often, the smaller value comes first. k never exceeds the number of distinct values in nums.",
  "constraints": [
    "1 <= len(nums) <= 20000",
    "-1000000000 <= nums[i] <= 1000000000",
    "1 <= k <= the number of distinct values"
  ],
  "parameters": ["nums", "k"],
  "functionName": "top_k_frequent",
  "starterCode": "def top_k_frequent(nums, k):\n    # Return the k most frequent values, most frequent first, smaller value on ties.\n    ...\n",
  "examples": [
    {
      "input": { "nums": [5, 3, 1, 3, 5, 5], "k": 2 },
      "output": [5, 3],
      "explanation": "5 appears three times and 3 appears twice"
    },
    {
      "input": { "nums": [4, 4, 4, 6, 6, 7], "k": 2 },
      "output": [4, 6],
      "explanation": "4 appears three times and 6 appears twice"
    }
  ],
  "hints": [
    "First count how often each value appears; a dictionary keyed by value does this in one pass.",
    "Once you have value and count pairs, the task is ordering by count with a deterministic tie-break.",
    "Sort the distinct values by the key (-count, value) and take the first k."
  ],
  "solution": "Count occurrences with a dictionary in one pass, then sort the distinct values so that higher counts come first and smaller values win ties, and return the first k. Counting is O(n) and sorting the d distinct values is O(d log d).",
  "solutionCode": "def top_k_frequent(nums, k):\n    counts = {}\n    for value in nums:\n        counts[value] = counts.get(value, 0) + 1\n    ranked = sorted(counts, key=lambda value: (-counts[value], value))\n    return ranked[:k]\n",
  "bruteForceCode": "def top_k_frequent(nums, k):\n    counts = {}\n    for value in nums:\n        counts[value] = counts.get(value, 0) + 1\n    distinct = list(counts)\n    result = []\n    for _ in range(k):\n        best = None\n        for value in distinct:\n            if value in result:\n                continue\n            if best is None:\n                best = value\n            elif counts[value] > counts[best]:\n                best = value\n            elif counts[value] == counts[best] and value < best:\n                best = value\n        result.append(best)\n    return result\n",
  "failureHint": "hidden tests include frequency ties, negative values, and a single-element array",
  "expectedComplexity": { "time": "O(n log n)", "space": "O(n)" },
