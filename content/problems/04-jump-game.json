{
  "id": "04-jump-game",
  "title": "Jump Game",
  "track": "Dynamic Programming",
  "difficulty": "medium",
  "topics": [
    "dynamic-programming",
    "greedy"
  ],
  "source": "canonical Jump Game concept; description, examples, and tests re-authored",
  "description": "The input is an array of non-negative integers. You start at the first position; from position i you may jump forward by any length up to nums[i] positions. Return True when the last position is reachable by some sequence of jumps, False otherwise.",
  "constraints": [
    "1 <= len(nums) <= 10000",
    "0 <= nums[i] <= 10000"
  ],
  "parameters": [
    "nums"
  ],
  "functionName": "can_jump",
  "starterCode": "def can_jump(nums):\n    # Return True when the last position is reachable.\n    ...\n",
  "examples": [
    {
      "input": {
        "nums": [
          2,
          0,
          1,
          3
        ]
      },
      "output": true,
      "explanation": "Jump to position 1 or 2, then onward: position 3 is reachable."
    },
    {
      "input": {
        "nums": [
          1,
          0,
          2
        ]
      },
      "output": false,
      "explanation": "The only first jump lands on the 0, and nothing moves from there."
    }
  ],
  "hints": [
    "A position matters only if you can actually stand on it.",
    "Sweep left to right carrying one number: the farthest position reachable so far.",
    "If you ever stand past that farthest mark you are stranded: return False. Otherwise extend the mark with i + nums[i]; True when it covers the end."
  ],
  "solution": "Greedy sweep: track the farthest reachable index; a position beyond it is unreachable, and every visited position extends the mark with i + nums[i]. O(n) time, O(1) space.",
  "solutionCode": "def can_jump(nums):\n    farthest = 0\n    for i, value in enumerate(nums):\n        if i > farthest:\n            return False\n        if i + value > farthest:\n            farthest = i + value\n        if farthest >= len(nums) - 1:\n            return True\n    return True\n",
  "bruteForceCode": "def can_jump(nums):\n    n = len(nums)\n    good = [False] * n\n    good[n - 1] = True\n    for i in range(n - 2, -1, -1):\n        limit = min(i + nums[i], n - 1)\n        for j in range(i + 1, limit + 1):\n            if good[j]:\n                good[i] = True\n                break\n    return good[0]\n",
  "failureHint": "hidden tests include a single position, zeros in the middle, and traps right before the end",
  "expectedComplexity": {
    "time": "O(n)",
    "space": "O(1)"
  },
