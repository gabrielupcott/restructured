{
  "id": "03-linked-list-cycle",
  "title": "Linked List Cycle",
  "track": "Linked Lists",
  "difficulty": "easy",
  "topics": [
    "linked-lists",
    "two-pointers"
  ],
  "source": "canonical Linked List Cycle concept; description, examples, and tests re-authored",
  "description": "The input is the first node of a singly linked list whose tail may point back to an earlier node instead of ending, forming a cycle. Return True when a cycle exists somewhere in the list, False otherwise. The cycle_at field in each test shows where the tail reconnects; your function receives only the first node.",
  "constraints": [
    "0 <= number of nodes <= 60000",
    "-10000 <= node values <= 10000"
  ],
  "parameters": [
    "head",
    "cycle_at"
  ],
  "functionName": "has_cycle",
  "starterCode": "class ListNode:\n    def __init__(self, value=0, next=None):\n        self.value = value\n        self.next = next\n\ndef has_cycle(head):\n    # return True when the list contains a cycle\n    ...\n",
  "prepareCode": "class ListNode:\n    def __init__(self, value=0, next=None):\n        self.value = value\n        self.next = next\n\ndef build_cycle(values, pos):\n    nodes = []\n    head = None\n    tail = None\n    for value in values:\n        node = ListNode(value)\n        if head is None:\n            head = tail = node\n        else:\n            tail.next = node\n            tail = node\n        nodes.append(node)\n    if pos >= 0 and nodes:\n        tail.next = nodes[pos]\n    return head\n\ndef prepare(raw):\n    head = build_cycle(raw[0], raw[1])\n    def finish(result):\n        node = head\n        while node is not None:\n            following = node.next\n            node.next = None\n            node = following\n        return result\n    return [head], finish\n",
  "examples": [
    {
      "input": {
        "head": [
          3,
          2,
          8,
          4
        ],
        "cycle_at": 1
      },
      "output": true,
      "explanation": "The tail points back to the node holding 2, so walking never ends."
    },
    {
      "input": {
        "head": [
          3,
          2,
          8,
          4
        ],
        "cycle_at": -1
      },
      "output": false,
      "explanation": "The tail ends at null, so the walk finishes."
    }
  ],
  "hints": [
    "Nodes never leave the list, so a returning walker must eventually pass someone who is still there.",
    "Send two walkers around at different speeds: if the list loops, the faster one laps the slower one.",
    "Advance slow by one and fast by two each step; they meet exactly when a cycle exists, and fast runs off the end otherwise."
  ],
  "solution": "Floyd two-pointer: slow moves one node per step, fast moves two. A cycle guarantees they meet inside it; a finite list ends under the fast pointer. O(n) time, O(1) space.",
  "solutionCode": "def has_cycle(head):\n    slow = fast = head\n    while fast is not None and fast.next is not None:\n        slow = slow.next\n        fast = fast.next.next\n        if slow is fast:\n            return True\n    return False\n",
  "bruteForceCode": "def has_cycle(head):\n    node = head\n    index = 0\n    while node is not None:\n        earlier = head\n        for _ in range(index):\n            if earlier is node:\n                return True\n            earlier = earlier.next\n        node = node.next\n        index += 1\n    return False\n",
  "failureHint": "hidden tests include a single node, an immediate loop, and a long tail before the loop",
  "expectedComplexity": {
    "time": "O(n)",
    "space": "O(1)"
  },
